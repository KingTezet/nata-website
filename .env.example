# Salin file ini jadi .env.local lalu isi. Jangan commit .env.local.

# URL situs (dipakai untuk metadata/SEO). Ganti saat sudah punya domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Admin (/admin) ----
# Wajib diisi supaya /admin aktif. Minimal 8 karakter. Pakai password yang panjang.
ADMIN_PASSWORD=
# Opsional: kunci penanda sesi login. Isi string acak panjang (>=32 karakter).
# Kalau kosong, kunci diturunkan dari ADMIN_PASSWORD (ganti password = semua sesi keluar).
ADMIN_SESSION_SECRET=

# ---- Penyimpanan produk (pilih salah satu) ----
# 1) Kosongkan keduanya  -> produk disimpan di file data/products.json.
#    Cocok untuk lokal. DI VERCEL file ini read-only, jadi admin tidak bisa menyimpan.
# 2) Isi keduanya        -> produk disimpan di Supabase (disarankan untuk produksi).
#    Jalankan supabase/schema.sql di SQL Editor Supabase dulu.
SUPABASE_URL=
# Pakai service_role key. RAHASIA: hanya dipakai di server, jangan pakai prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
